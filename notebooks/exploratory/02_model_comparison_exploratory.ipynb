    "    \"side_trunk_angle_p05_deg\",\n",
    "    \"side_trunk_angle_p95_deg\",\n",
    "    \"side_trunk_angle_p05_p95_range_deg\",\n",
    "    \"top_net_body_displacement_torso\",\n",
    "    \"top_max_body_excursion_torso\",\n",
    "    \"top_body_path_distance_torso\",\n",
    "    \"top_average_body_path_rate_torso_per_sec\",\n",
    "    \"top_left_arm_path_distance_torso\",\n",
    "    \"top_left_arm_average_speed_torso_per_sec\",\n",
    "    \"top_left_arm_p95_speed_torso_per_sec\",\n",
    "    \"top_right_arm_path_distance_torso\",\n",
