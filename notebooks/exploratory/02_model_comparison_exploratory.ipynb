   "source": [
    "\n",
    "## 14. Participant-grouped cross-validation\n",
    "\n",
    "A custom loop keeps all trials from one participant together and allows every model to be evaluated on exactly the same folds.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fdcc3864",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "model_rows = []\n",
    "prediction_table = pd.DataFrame({\n",
    "    \"trial_id\": df[\"trial_id\"],\n",
    "    \"participant_id\": df[\"participant_id\"],\n",
    "    \"actual_cluster\": y_model,\n",
    "})\n",
    "\n",
    "for model_name, factory in MODEL_FACTORIES.items():\n",
    "    start = time.time()\n",
    "    pred = np.full(len(y_model), -1, dtype=int)\n",
    "\n",
    "    for train_idx, test_idx in FOLDS:\n",
    "        model = factory()\n",
    "        model.fit(X_model.iloc[train_idx], y_model[train_idx])\n",
    "        fold_pred = np.asarray(\n",
    "            model.predict(X_model.iloc[test_idx])\n",
    "        ).reshape(-1).astype(int)\n",
    "        pred[test_idx] = fold_pred\n",
    "\n",
    "    model_rows.append({\n",
    "        \"model\": model_name,\n",
    "        \"accuracy\": accuracy_score(y_model, pred),\n",
    "        \"balanced_accuracy\": balanced_accuracy_score(y_model, pred),\n",
    "        \"macro_precision\": precision_score(y_model, pred, average=\"macro\", zero_division=0),\n",
    "        \"macro_recall\": recall_score(y_model, pred, average=\"macro\", zero_division=0),\n",
    "        \"macro_f1\": f1_score(y_model, pred, average=\"macro\", zero_division=0),\n",
    "        \"weighted_f1\": f1_score(y_model, pred, average=\"weighted\", zero_division=0),\n",
    "        \"runtime_seconds\": time.time() - start,\n",
    "    })\n",
    "\n",
    "    prediction_table[model_name] = pred\n",
    "\n",
    "model_results = pd.DataFrame(model_rows).sort_values(\n",
    "    \"macro_f1\", ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "display(model_results.round(4))\n",
    "\n",
    "model_results.to_csv(OUTPUT_DIR / \"all_model_comparison.csv\", index=False)\n",
    "prediction_table.to_csv(OUTPUT_DIR / \"all_model_cross_validated_predictions.csv\", index=False)\n"
   ]
  },
